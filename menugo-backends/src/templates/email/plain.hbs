<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{{title}}</title>
  </head>
  <body style="font-family:Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial; background:#f6f8fb; margin:0; padding:24px; color:#111">
    <table align="center" width="100%" cellpadding="0" cellspacing="0" style="max-width:680px; margin:0 auto;">
      <tr>
        <td style="padding:24px 0; text-align:center">
          <img src="{{logoUrl}}" alt="{{appName}}" style="height:40px; object-fit:contain" />
        </td>
      </tr>
      <tr>
        <td>
          <div style="background:#ffffff;border-radius:12px;padding:28px;box-shadow:0 6px 18px rgba(15,23,42,0.06)">
            <h1 style="font-size:18px;margin:0 0 12px;color:#0f172a">{{heading}}</h1>
            <div style="font-size:14px;line-height:1.6;color:#334155">{{{body}}}</div>
          </div>
        </td>
      </tr>
      <tr>
        <td style="padding-top:18px; text-align:center; color:#94a3b8; font-size:12px">
          <div>{{appName}} — &copy; {{year}}</div>
          <div style="margin-top:6px">If you did not expect this email, please ignore it.</div>
        </td>
      </tr>
    </table>
  </body>
</html>