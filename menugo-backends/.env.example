# Backend example environment variables
# Copy this file to .env and fill secrets before running

# Server
PORT=5000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=menugo
DB_PASSWORD=menugo
DB_NAME=menugo
DB_POOL_MAX=10

# Allow sequelize to alter schema on startup (development only)
DB_SYNC_ALTER=false

# Redis (optional)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Cloudinary (optional for file uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Other
ALLOW_PORT_FALLBACK=true
# ============================================
# MenuGo Backend Environment Configuration (MySQL)
# ============================================
# Copy this file to .env and update with your values

# Server Configuration
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=menugo_db
DB_USER=root
DB_PASSWORD=Haymi@mysql1
DB_DIALECT=mysql
DB_SYNC_ALTER=false

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_SECRET=change-this-to-random-string
JWT_REFRESH_SECRET=change-this-to-random-string
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@menugo.com
EMAIL_FROM_NAME=MenuGo Platform

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Stripe Configuration (Optional)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Telebirr/Fabric Configuration (Optional)
TELEBIRR_FABRIC_BASE_URL=https://example.telebirr.com
TELEBIRR_APP_ID=your-app-id
TELEBIRR_APP_SECRET=your-app-secret
TELEBIRR_MERCHANT_CODE=your-merchant-code
TELEBIRR_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
TELEBIRR_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
TELEBIRR_WEB_BASE_URL=https://developerportal.ethiotelebirr.et:38443/payment/web/paygate?
TELEBIRR_NOTIFY_URL=https://api.example.com/api/auth/register/telebirr/callback
TELEBIRR_RETURN_URL=https://app.example.com/register/payment
TELEBIRR_TIMEOUT_SECONDS=60
REGISTRATION_FEE_AMOUNT=500
REGISTRATION_FEE_CURRENCY=ETB

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE=5242880

# Logging
LOG_LEVEL=info

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Facebook OAuth (optional)
# Create a Facebook app at https://developers.facebook.com/ and set these values
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=
