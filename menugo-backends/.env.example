# Backend example environment variables
# Copy this file to .env and fill secrets before running

# Server
PORT=5000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=menugo
DB_PASSWORD=menugo
DB_NAME=menugo
DB_POOL_MAX=10

# Allow sequelize to alter schema on startup (development only)
DB_SYNC_ALTER=false

# Redis (optional)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Cloudinary (optional for file uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Other
ALLOW_PORT_FALLBACK=true
# ============================================
# MenuGo Backend Environment Configuration (MySQL)
# ============================================
# Copy this file to .env and update with your values

# Server Configuration
NODE_ENV=development
PORT=5003
API_URL=http://localhost:5003
CLIENT_URL=http://localhost:5173

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:menugo@localhost:5432/menugo_db?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_NAME=menugo_db
DB_USER=postgres
DB_PASSWORD=menugo
DB_DIALECT=postgres
DB_SYNC_ALTER=false

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_SECRET=change-this-to-random-string
JWT_REFRESH_SECRET=change-this-to-random-string
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Email Configuration
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-brevo-login@smtp-brevo.com
SMTP_PASS=your-brevo-smtp-key
EMAIL_FROM=your-verified-sender@example.com
EMAIL_FROM_NAME=MenuGo Platform
# Preferred for Render/cloud hosting: Brevo transactional API over HTTPS (not the SMTP key)
BREVO_API_KEY=your-brevo-api-key

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Stripe Configuration (Optional)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

REGISTRATION_FEE_AMOUNT=500
REGISTRATION_FEE_CURRENCY=ETB

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE=5242880

# Logging
LOG_LEVEL=info

# CORS
CORS_ORIGIN=http://localhost:5173

# Facebook OAuth (optional)
# Create a Facebook app at https://developers.facebook.com/ and set these values
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=






















































