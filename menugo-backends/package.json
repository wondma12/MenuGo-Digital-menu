{
  "name": "menugo-backend",
  "version": "1.0.0",
  "description": "MenuGo Digital Menu SaaS Platform Backend API (MySQL Version)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:debug": "node --watch --inspect=9229 src/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "seed": "node scripts/seedDatabase.js",
    "seed:prod": "NODE_ENV=production node scripts/seedDatabase.js",
    "migrate": "node scripts/migrateDatabase.js",
    "migrate:reset": "node scripts/migrateDatabase.js --reset",
    "add:waiter:is_active": "node scripts/addWaiterIsActive.js",
    "backup": "node scripts/backupDatabase.js",
    "backup:list": "node scripts/backupDatabase.js list",
    "restore": "node scripts/backupDatabase.js restore",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:logs": "pm2 logs menugo-backend",
    "pm2:monit": "pm2 monit",
    "dev:local-api": "node local_dev_server.js"
  },
  "keywords": [
    "menu",
    "restaurant",
    "digital-menu",
    "qr-code",
    "saas",
    "mysql",
    "nodejs",
    "express"
  ],
  "author": "MenuGo Team",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.14.0",
    "bcryptjs": "^2.4.3",
    "body-parser": "^2.2.2",
    "cloudinary": "^2.9.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "exceljs": "^3.4.0",
    "express": "^4.22.1",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^6.11.2",
    "express-validator": "^6.15.0",
    "handlebars": "^4.7.9",
    "helmet": "^7.2.0",
    "joi": "^18.1.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^1.4.5-lts.1",
    "mysql": "^2.18.1",
    "mysql2": "^3.20.0",
    "sqlite3": "^5.1.6",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.5",
    "nodemon": "^3.1.14",
    "passport": "^0.6.0",
    "passport-facebook": "^3.0.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.13.0",
    "qrcode": "^1.5.4",
    "redis": "^4.7.1",
    "sequelize": "^3.30.0",
    "sequelize-cli": "^6.6.0",
    "shortid": "^2.2.17",
    "socket.io": "^4.8.3",
    "stripe": "^12.18.0",
    "uuid": "^14.0.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "eslint": "^8.38.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-node": "^11.1.0",
    "jest": "^29.5.0",
    "prettier": "^2.8.7",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
